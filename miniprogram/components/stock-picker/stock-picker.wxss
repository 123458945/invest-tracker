.stock-picker{
  position: relative;
}

.search-input{
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.searching-hint{
  position: absolute;
  right: 20rpx;
  top: 25rpx;
  color: #999;
  font-size: 24rpx;
}

.stock-list{
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  max-height: 400rpx;
  background-color: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  overflow-y: auto;
  z-index: 100;
}

.stock-item{
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.stock-item:last-child{
  border-bottom: none;
}

.stock-info{
  flex: 1;
}

.stock-code{
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.stock-name{
  display: block;
  font-size: 28rpx;
  color: #333;
}

.stock-price{
  font-size: 28rpx;
  color: #1976d2;
  font-weight: bold;
}

.selected-stock{
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #e8f5e9;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #4caf50;
}
