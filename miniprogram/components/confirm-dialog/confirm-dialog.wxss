.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.dialog-container {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.dialog-content {
  padding: 48rpx 32rpx 32rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.dialog-message {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.dialog-input-wrapper {
  margin-bottom: 24rpx;
}

.dialog-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.dialog-input:focus {
  border-color: #1976d2;
}

.dialog-input-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 12rpx;
}

.dialog-buttons {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.dialog-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 0;
  border: none;
  background: transparent;
}

.dialog-btn::after {
  border: none;
}

.dialog-btn.cancel {
  border-right: 1rpx solid #f0f0f0;
  color: #666;
}

.dialog-btn.confirm {
  font-weight: 600;
}

.dialog-btn.confirm.danger {
  color: #ef4444;
}
