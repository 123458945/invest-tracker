.dialog-mask{
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.dialog-container{
  width: 80%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.dialog-title{
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  padding: 40rpx 30rpx 20rpx;
  color: #333;
}

.dialog-content{
  padding: 20rpx 30rpx 40rpx;
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}

.dialog-buttons{
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.dialog-btn{
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 32rpx;
  border: none;
  border-radius: 0;
  background-color: transparent;
}

.dialog-btn.cancel{
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.dialog-btn.confirm{
  color: #1976d2;
  font-weight: bold;
}

.dialog-btn::after{
  border: none;
}
