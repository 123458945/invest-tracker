.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  min-height: 400rpx;
}

.empty-icon-text {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  line-height: 1;
}

.empty-icon-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.empty-action {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #1976d2 0%, #1565c0 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.empty-action::after {
  border: none;
}
