/* 普通加载模式 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1976d2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* 骨架屏通用样式 */
.skeleton-container {
  padding: 24rpx;
}

/* 骨架屏动画 */
@keyframes skeleton-loading {
  0% {
    background-position: -200rpx 0;
  }
  100% {
    background-position: calc(200rpx + 100%) 0;
  }
}

.skeleton-avatar,
.skeleton-icon,
.skeleton-title,
.skeleton-text,
.skeleton-cell,
.skeleton-card-value,
.skeleton-card-title,
.skeleton-card-text {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200rpx 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

/* 列表骨架屏 */
.skeleton-list .skeleton-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.skeleton-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.skeleton-content {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.skeleton-title {
  height: 32rpx;
  width: 60%;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
}

.skeleton-title.large {
  height: 40rpx;
  width: 80%;
}

.skeleton-text {
  height: 24rpx;
  width: 80%;
  margin-bottom: 12rpx;
  border-radius: 6rpx;
}

.skeleton-text.short {
  width: 50%;
}

.skeleton-text.long {
  width: 100%;
}

/* 卡片骨架屏 */
.skeleton-card {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.skeleton-card-item {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.skeleton-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.skeleton-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.skeleton-card-title {
  height: 24rpx;
  width: 60%;
  border-radius: 6rpx;
}

.skeleton-card-value {
  height: 48rpx;
  width: 80%;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
}

.skeleton-card-text {
  height: 20rpx;
  width: 60%;
  border-radius: 6rpx;
}

/* 详情骨架屏 */
.skeleton-detail-header {
  display: flex;
  align-items: center;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 32rpx;
}

.skeleton-avatar.large {
  width: 100rpx;
  height: 100rpx;
}

.skeleton-detail-info {
  flex: 1;
  margin-left: 24rpx;
}

.skeleton-detail-body {
  margin-bottom: 32rpx;
}

.skeleton-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.skeleton-cell {
  width: 45%;
  height: 60rpx;
  border-radius: 8rpx;
}

.skeleton-detail-footer {
  padding-top: 32rpx;
  border-top: 1rpx solid #f0f0f0;
}
