<view class="container">
  <view class="page-header">
    <text class="page-title">持仓管理</text>
    <view class="header-actions">
      <button class="action-btn" bindtap="navigateToTransactions" size="mini">
        交易记录
      </button>
      <button class="action-btn" bindtap="handleUpdatePrices" loading="{{updating}}" disabled="{{updating || holdings.length === 0}}" size="mini">
        {{updating ? '更新中' : '更新价格'}}
      </button>
      <button class="action-btn primary" bindtap="navigateToAddHolding" size="mini">
        添加持仓
      </button>
    </view>
  </view>

  <!-- 加载骨架屏 -->
  <loading show="{{loading}}" skeleton="{{true}}" skeletonType="list" skeletonRows="{{4}}" wx:if="{{loading}}" />

  <!-- 错误提示 -->
  <view class="error-message" wx:elif="{{error}}">
    {{error}}
  </view>

  <view wx:else>
    <!-- 空状态 -->
    <empty-state
      wx:if="{{holdings.length === 0}}"
      type="empty"
      text="暂无持仓数据"
      showAction="{{true}}"
      actionText="添加持仓"
      bind:action="navigateToAddHolding"
    />

    <view wx:else>
      <!-- 汇总浮动条 -->
      <view class="summary-float">
        <view class="summary-content">
          <view class="summary-row">
            <view class="summary-item">
              <text class="summary-label">总市值</text>
              <text class="summary-value">{{totalMarketValue}}</text>
            </view>
            <view class="summary-item">
              <text class="summary-label">总盈亏</text>
              <text class="summary-value {{totalProfitLoss >= 0 ? 'text-danger' : 'text-success'}}">{{totalProfitLoss}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 按市场分组显示 -->
      <view wx:for="{{groupedHoldings}}" wx:for-item="group" wx:key="index">
        <view class="group-section">
          <text class="group-title">{{group.key === 'sh' ? '上海' : '深圳'}}</text>
          <text class="group-total">{{group.summary.totalMarketValue}}</text>
        </view>

        <view class="holdings-list">
          <view class="holding-item" wx:for="{{group.items}}" wx:key="_id">
            <view class="holding-header">
              <view class="holding-info">
                <text class="holding-name">{{item.stockName}}</text>
                <text class="holding-code">{{item.stockCode}}</text>
              </view>
              <view class="holding-actions">
                <text class="action-icon" bindtap="handleEdit" data-id="{{item._id}}">✏️</text>
                <text class="action-icon" bindtap="handleSell" data-id="{{item._id}}" data-name="{{item.stockName}}" data-quantity="{{item.quantity}}" data-price="{{item.currentPrice}}">💰</text>
                <text class="action-icon" bindtap="handleDelete" data-id="{{item._id}}" data-name="{{item.stockName}}">🗑</text>
              </view>
            </view>

            <view class="holding-details">
              <view class="detail-row">
                <view class="detail-item">
                  <text class="detail-label">持仓数量</text>
                  <text class="detail-value">{{item.quantity}}</text>
                </view>
                <view class="detail-item">
                  <text class="detail-label">成本价</text>
                  <text class="detail-value">¥{{item.avgBuyPrice}}</text>
                </view>
                <view class="detail-item">
                  <text class="detail-label">现价</text>
                  <text class="detail-value">¥{{item.currentPrice}}</text>
                </view>
              </view>

              <view class="detail-row">
                <view class="detail-item">
                  <text class="detail-label">市值</text>
                  <text class="detail-value">¥{{item.marketValue}}</text>
                </view>
                <view class="detail-item">
                  <text class="detail-label">盈亏</text>
                  <text class="detail-value {{item.profitLoss >= 0 ? 'text-danger' : 'text-success'}}">
                    {{item.profitLoss >= 0 ? '+' : ''}}¥{{item.profitLoss}}
                  </text>
                </view>
                <view class="detail-item">
                  <text class="detail-label">收益率</text>
                  <text class="detail-value {{item.profitLossRate >= 0 ? 'text-danger' : 'text-success'}}">
                    {{item.profitLossRate >= 0 ? '+' : ''}}{{item.profitLossRate}}%
                  </text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
