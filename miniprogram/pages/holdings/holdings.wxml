<view class="container">
  <view class="page-header">
    <text class="page-title">持仓管理</text>
    <view class="header-actions">
      <button class="action-btn" bindtap="navigateToTransactions" size="mini">交易记录</button>
      <button class="action-btn" bindtap="handleUpdatePrices" loading="{{updating}}" disabled="{{updating || holdings.length === 0}}" size="mini">
        {{updating ? '更新中' : '更新价格'}}
      </button>
      <button class="action-btn primary" bindtap="openAddDialog" size="mini">添加持仓</button>
    </view>
  </view>

  <view class="error-message" wx:if="{{error}}">
    {{error}}
  </view>

  <!-- 统计摘要 -->
  <view class="card summary-card" wx:if="{{holdings.length > 0}}">
    <view class="summary-grid">
      <view class="summary-item">
        <text class="summary-label">总市值</text>
        <text class="summary-value">{{totalMarketValue}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">未实现盈亏</text>
        <text class="summary-value {{totalUnrealizedProfit >= 0 ? 'text-danger' : 'text-success'}}">{{totalUnrealizedProfit}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">已实现盈亏</text>
        <text class="summary-value {{totalRealizedProfit >= 0 ? 'text-danger' : 'text-success'}}">{{totalRealizedProfit}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">总盈亏</text>
        <text class="summary-value {{totalProfit >= 0 ? 'text-danger' : 'text-success'}}">{{totalProfit}}</text>
      </view>
    </view>
  </view>

  <!-- 持仓列表 -->
  <view class="holdings-list" wx:if="{{holdings.length > 0}}">
    <view class="holding-item" wx:for="{{holdings}}" wx:key="_id">
      <view class="holding-header">
        <view class="holding-info">
          <text class="holding-name">{{item.stockName}}</text>
          <text class="holding-code">{{item.stockCode}}</text>
        </view>
        <view class="holding-actions">
          <text class="action-icon" bindtap="handleEdit" data-holding="{{item}}">✏️</text>
          <text class="action-icon" bindtap="handleSell" data-holding="{{item}}">💰</text>
          <text class="action-icon" bindtap="handleDelete" data-holding="{{item}}">🗑️</text>
        </view>
      </view>
      
      <view class="holding-details">
        <view class="detail-row">
          <view class="detail-item">
            <text class="detail-label">持仓数量</text>
            <text class="detail-value">{{item.quantity}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">成本价</text>
            <text class="detail-value">¥{{item.avgBuyPrice}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">现价</text>
            <text class="detail-value">¥{{item.currentPrice}}</text>
          </view>
        </view>
        
        <view class="detail-row">
          <view class="detail-item">
            <text class="detail-label">市值</text>
            <text class="detail-value">¥{{item.marketValue}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">盈亏</text>
            <text class="detail-value {{item.profitLoss >= 0 ? 'text-danger' : 'text-success'}}">
              {{item.profitLoss >= 0 ? '+' : ''}}¥{{item.profitLoss}}
            </text>
          </view>
          <view class="detail-item">
            <text class="detail-label">收益率</text>
            <text class="detail-value {{item.profitLossRate >= 0 ? 'text-danger' : 'text-success'}}">
              {{item.profitLossRate >= 0 ? '+' : ''}}{{item.profitLossRate}}%
            </text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && holdings.length === 0}}">
    <view class="empty-icon">📊</view>
    <view class="empty-text">暂无持仓</view>
    <button class="empty-action" bindtap="openAddDialog">添加持仓</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
