.page-header {
  margin-bottom: 30rpx;
}

.header-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.action-btn {
  background-color: #f5f5f5;
  color: #666666;
  border: 1rpx solid #e0e0e0;
}

.action-btn.primary {
  background-color: #1976d2;
  color: #ffffff;
  border: none;
}

.summary-card {
  margin-bottom: 30rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
}

.summary-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.holdings-list {
  margin-bottom: 30rpx;
}

.holding-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.holding-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.holding-info {
  display: flex;
  flex-direction: column;
}

.holding-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 4rpx;
}

.holding-code {
  font-size: 24rpx;
  color: #999999;
}

.holding-actions {
  display: flex;
  gap: 20rpx;
}

.action-icon {
  font-size: 32rpx;
  cursor: pointer;
}

.holding-details {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
}

.detail-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.detail-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.text-danger {
  color: #d32f2f !important;
}

.text-success {
  color: #2e7d32 !important;
}

.empty-action {
  margin-top: 20rpx;
  background-color: #1976d2;
  color: #ffffff;
}
