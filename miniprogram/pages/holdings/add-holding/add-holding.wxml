<view class="container">
  <view class="form-section">
    <view class="section-title">股票信息</view>

    <!-- 使用 stock-picker 组件搜索股票 -->
    <stock-picker
      placeholder="输入股票代码或名称搜索"
      showHistory="{{true}}"
      selectedStock="{{stockCode ? { code: stockCode, name: stockName } : null}}"
      bind:select="onStockSelect"
    />

    <!-- 已选择股票信息 -->
    <view wx:if="{{stockCode}}" class="selected-info">
      <text class="selected-stock-name">{{stockName}}</text>
      <text class="selected-stock-code">{{stockCode}}</text>
      <text wx:if="{{stockInfo}}" class="selected-price">当前价: ¥{{stockInfo.currentPrice}}</text>
    </view>

    <view class="weui-cells weui-cells_after-title" wx:if="{{stockCode}}">
      <view class="weui-cell weui-cell_select">
        <view class="weui-cell__hd">
          <view class="weui-label required">市场</view>
        </view>
        <view class="weui-cell__bd">
          <picker bindchange="onMarketChange" value="{{marketIndex}}" range="{{markets}}" range-key="label">
            <view class="weui-select">{{markets[marketIndex].label}}</view>
          </picker>
        </view>
      </view>
    </view>
  </view>

  <view class="form-section" wx:if="{{stockCode}}">
    <view class="section-title">交易信息</view>

    <view class="weui-cells weui-cells_after-title">
      <view class="weui-cell weui-cell_select">
        <view class="weui-cell__hd">
          <view class="weui-label required">资产类型</view>
        </view>
        <view class="weui-cell__bd">
          <picker bindchange="onAssetTypeChange" value="{{assetTypeIndex}}" range="{{assetTypes}}" range-key="label">
            <view class="weui-select">{{assetTypes[assetTypeIndex].label}}</view>
          </picker>
        </view>
      </view>

      <view class="weui-cell weui-cell_input">
        <view class="weui-cell__hd">
          <view class="weui-label required">买入数量</view>
        </view>
        <view class="weui-cell__bd">
          <input class="weui-input" placeholder="请输入股数" value="{{quantity}}" bindinput="onQuantityInput" type="digit" />
        </view>
        <view class="weui-cell__ft">股</view>
      </view>

      <view class="weui-cell weui-cell_input">
        <view class="weui-cell__hd">
          <view class="weui-label required">买入价格</view>
        </view>
        <view class="weui-cell__bd">
          <input class="weui-input" placeholder="请输入价格" value="{{buyPrice}}" bindinput="onBuyPriceInput" type="digit" />
        </view>
        <view class="weui-cell__ft">元/股</view>
      </view>

      <view class="weui-cell weui-cell_input">
        <view class="weui-cell__hd">
          <view class="weui-label required">买入日期</view>
        </view>
        <view class="weui-cell__bd">
          <picker mode="date" value="{{buyDate}}" start="2020-01-01" end="{{today}}" bindchange="onBuyDateChange">
            <view class="weui-input">{{buyDate}}</view>
          </picker>
        </view>
      </view>
    </view>

    <view class="weui-cells__tips" wx:if="{{estimatedAmount}}">
      <text>预计金额: ¥{{estimatedAmount}}</text>
    </view>
  </view>

  <view class="error-message" wx:if="{{error}}">
    {{error}}
  </view>

  <view class="button-group" wx:if="{{stockCode}}">
    <button class="weui-btn" type="default" bindtap="handleCancel">取消</button>
    <button class="weui-btn primary-btn" type="primary" bindtap="handleSubmit" loading="{{submitting}}" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '确认添加'}}
    </button>
  </view>
</view>
