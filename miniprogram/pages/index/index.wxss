.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.refresh-btn {
  background-color: #1976d2;
  color: #ffffff;
}

.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx 0;
  background-color: #ffffff;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
}

.action-btn.primary {
  background-color: #1976d2;
  color: #ffffff;
  border-color: #1976d2;
}

.stat-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.stat-card.highlight {
  background: linear-gradient(135deg, #1976d2, #42a5f5);
}

.stat-card.highlight .stat-title,
.stat-card.highlight .stat-subtitle {
  color: rgba(255, 255, 255, 0.8);
}

.stat-card.highlight .stat-value {
  color: #ffffff;
}

.stat-card.highlight .stat-icon {
  font-size: 36rpx;
}

.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.stat-title {
  font-size: 24rpx;
  color: #999999;
}

.stat-icon {
  font-size: 32rpx;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.stat-subtitle {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.text-danger {
  color: #d32f2f !important;
}

.text-success {
  color: #2e7d32 !important;
}

.text-muted {
  color: #999999;
}

.distribution-info {
  display: flex;
  justify-content: space-around;
}

.dist-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dist-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.dist-value {
  font-size: 32rpx;
  font-weight: bold;
}

.chart-card {
  margin-bottom: 30rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.allocation-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.allocation-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.allocation-left {
  flex: 1;
  height: 24rpx;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.allocation-bar {
  height: 100%;
  border-radius: 12rpx;
  min-width: 8rpx;
}

.allocation-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 200rpx;
}

.allocation-name {
  font-size: 26rpx;
  color: #333333;
}

.allocation-percent {
  font-size: 26rpx;
  color: #999999;
}

.ranking-section {
  margin-top: 20rpx;
}

.ranking-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #666666;
  margin-bottom: 16rpx;
}

.ranking-list {
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.ranking-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-left {
  display: flex;
  flex-direction: column;
}

.ranking-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.ranking-code {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.ranking-right {
  font-size: 28rpx;
  font-weight: bold;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1976d2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999999;
}

/* 错误提示 */
.error-message {
  text-align: center;
  padding: 40rpx;
  color: #d32f2f;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-guide {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.empty-action {
  padding: 16rpx 32rpx;
  background-color: #1976d2;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 28rpx;
}
