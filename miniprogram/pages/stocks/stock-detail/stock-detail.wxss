.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.error-msg {
  background-color: #fff3f3;
  color: #d32f2f;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
}

.quote-card {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stock-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.stock-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.stock-code {
  font-size: 24rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 5rpx 15rpx;
  border-radius: 4rpx;
}

.price-section {
  margin-bottom: 30rpx;
}

.current-price {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.current-price.up {
  color: #f44336;
}

.current-price.down {
  color: #4caf50;
}

.change-info {
  display: flex;
  align-items: center;
}

.change, .change-percent {
  font-size: 28rpx;
  margin-right: 20rpx;
}

.change.up, .change-percent.up {
  color: #f44336;
}

.change.down, .change-percent.down {
  color: #4caf50;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.detail-item {
  text-align: center;
}

.detail-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.detail-value.up {
  color: #f44336;
}

.detail-value.down {
  color: #4caf50;
}

.chart-card {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.chart-canvas {
  width: 100%;
  height: 300rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.ma-data {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-around;
}

.ma-item {
  text-align: center;
}

.ma-label {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.ma-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
