<view class="container">
  <view class="page-header">
    <text class="page-title">股票行情</text>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="输入股票代码或名称搜索" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="handleSearch" />
    <button class="search-btn" bindtap="handleSearch" loading="{{searching}}">搜索</button>
  </view>

  <view class="error-message" wx:if="{{error}}">
    {{error}}
  </view>

  <view class="stocks-list" wx:if="{{stocks.length > 0}}">
    <view class="stock-item" wx:for="{{stocks}}" wx:key="stockCode" bindtap="handleStockClick" data-stock="{{item}}">
      <view class="stock-info">
        <text class="stock-name">{{item.stockName}}</text>
        <text class="stock-code">{{item.stockCode}}</text>
      </view>
      <view class="stock-price-info">
        <text class="stock-price">¥{{item.currentPrice}}</text>
        <text class="stock-change {{item.changePercent >= 0 ? 'text-danger' : 'text-success'}}">
          {{item.changePercent >= 0 ? '+' : ''}}{{item.changePercent}}%
        </text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!searching && stocks.length === 0 && keyword}}">
    <view class="empty-icon">🔍</view>
    <view class="empty-text">未找到相关股票</view>
  </view>

  <view class="empty-state" wx:if="{{!keyword && stocks.length === 0}}">
    <view class="empty-icon">📈</view>
    <view class="empty-text">搜索股票查看行情</view>
  </view>

  <view class="loading" wx:if="{{searching}}">
    <text>搜索中...</text>
  </view>
</view>
