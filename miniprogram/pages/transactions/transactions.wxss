.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.stats-card {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stat-value.profit {
  color: #f44336;
}

.stat-value.loss {
  color: #4caf50;
}

.filter-section {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.filter-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
}

.filter-picker {
  padding: 10rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.transaction-list {
  background-color: #fff;
  border-radius: 8rpx;
  overflow: hidden;
}

.transaction-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.transaction-item:last-child {
  border-bottom: none;
}

.transaction-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.stock-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.transaction-type {
  font-size: 24rpx;
  padding: 5rpx 15rpx;
  border-radius: 4rpx;
}

.transaction-type.buy {
  background-color: #e8f5e9;
  color: #4caf50;
}

.transaction-type.sell {
  background-color: #ffebee;
  color: #f44336;
}

.transaction-detail {
  margin-bottom: 15rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.detail-label {
  color: #999;
}

.detail-value {
  color: #333;
  font-weight: 500;
}

.detail-value.profit {
  color: #f44336;
}

.detail-value.loss {
  color: #4caf50;
}

.transaction-footer {
  display: flex;
  justify-content: flex-end;
}

.transaction-date {
  font-size: 24rpx;
  color: #999;
}

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #999;
}
